APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_DB_URL=

# Vercel AI Gateway / TypeSafe Jev Configuration
# When using Vercel AI Gateway, set AI_GATEWAY_API_KEY.
# The base URL defaults to https://ai-gateway.vercel.sh/typesafe.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/typesafe
JEV_MODEL=typesafe-ai/jev
JEV_TIMEOUT=30.0

# Direct TypeSafe API fallback (if not routing through Vercel AI Gateway)
TYPESAFE_API_KEY=

# Future LLM Baseline Configuration (Phase 4)
LLM_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=